#pragma once

typedef enum {
    TUTORIAL_NONE,
    TUTORIAL_BATTLE_START,
    TUTORIAL_BATTLE_HOVER_ENEMY,
    TUTORIAL_BATTLE_SELECT_PIECE,
    TUTORIAL_BATTLE_DRAG_PIECE,
    TUTORIAL_BATTLE_COMPLETE_CIRCUIT,
    TUTORIAL_BATTLE_CAST_SPELL,
    TUTORIAL_SHOP_START,
    TUTORIAL_SHOP_HOVER_ITEM,
    TUTORIAL_SHOP_BUY_ITEM,
} TutorialState;

// Tutorial save data structure
typedef struct {
    int battle_completed;
    int shop_completed;
} TutorialSaveData;

// Initialize tutorial system
void Tutorial_Init(void);

// Update tutorial state
void Tutorial_Update(void);

// Draw tutorial UI
void Tutorial_Draw(void);

// Set current tutorial state
void Tutorial_SetState(TutorialState state);

// Check if specific tutorial is complete
int Tutorial_IsComplete(TutorialState state);

// Save tutorial progress
void Tutorial_SaveProgress(void);

// Load tutorial progress
void Tutorial_LoadProgress(void);