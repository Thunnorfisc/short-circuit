#include "creditScreen.h"
#include "cprocessing.h"
#include "mainMenuSystem.h"

// Define positions for credits text
#define CREDITS_TITLE_Y     0.1f
#define CREDITS_START_Y     0.2f
#define CREDITS_LINE_SPACE  0.05f

void Credits_Init(void) {
    CP_Settings_RectMode(CP_POSITION_CENTER);
    CP_Font_Load("Assets/Exo2-Regular.ttf");
    CP_Settings_TextAlignment(CP_TEXT_ALIGN_H_CENTER, CP_TEXT_ALIGN_V_TOP);
}

void Credits_Update(void) {
    // Clear background
    CP_Graphics_ClearBackground(CP_Color_Create(0, 0, 0, 255));

    float windowWidth = (float)CP_System_GetWindowWidth();
    float windowHeight = (float)CP_System_GetWindowHeight();
    float currentY = windowHeight * CREDITS_START_Y;

    // Save current settings
    CP_Settings_Save();

    // Draw title
    CP_Settings_TextSize(50.0f);
    CP_Settings_Fill(CP_Color_Create(255, 255, 255, 255));
    CP_Font_DrawText("CREDITS", windowWidth * 0.5f, windowHeight * CREDITS_TITLE_Y);

    // Draw credits content
    CP_Settings_TextSize(30.0f);

    // Team Members
    CP_Font_DrawText("Team Members", windowWidth * 0.5f, currentY);
    currentY += windowHeight * CREDITS_LINE_SPACE;
    CP_Settings_TextSize(25.0f);
    CP_Font_DrawText("John Doe - Lead Programmer", windowWidth * 0.5f, currentY);
    currentY += windowHeight * CREDITS_LINE_SPACE;
    CP_Font_DrawText("Jane Smith - Artist", windowWidth * 0.5f, currentY);
    currentY += windowHeight * CREDITS_LINE_SPACE * 2;

    // Advisors
    CP_Settings_TextSize(30.0f);
    CP_Font_DrawText("Advisors", windowWidth * 0.5f, currentY);
    currentY += windowHeight * CREDITS_LINE_SPACE;
    CP_Settings_TextSize(25.0f);
    CP_Font_DrawText("Professor Johnson - Technical Advisor", windowWidth * 0.5f, currentY);
    currentY += windowHeight * CREDITS_LINE_SPACE * 2;

    // Special Thanks
    CP_Settings_TextSize(30.0f);
    CP_Font_DrawText("Special Thanks", windowWidth * 0.5f, currentY);
    currentY += windowHeight * CREDITS_LINE_SPACE;
    CP_Settings_TextSize(25.0f);
    CP_Font_DrawText("DigiPen Institute of Technology Singapore", windowWidth * 0.5f, currentY);

    // Draw return instruction
    currentY = windowHeight * 0.9f;
    CP_Settings_TextSize(20.0f);
    CP_Font_DrawText("Press ESC to return to Main Menu", windowWidth * 0.5f, currentY);

    // Restore settings
    CP_Settings_Restore();

    // Handle input
    if (CP_Input_KeyTriggered(KEY_ESCAPE)) {
        CP_Engine_SetNextGameStateForced(Main_Menu_Init, Main_Menu_Update, Main_Menu_Exit);
    }
}

void Credits_Exit(void) {
    // Clean up if needed
}